# Amnis — .gitignore

# Data (personal memories, knowledge base, vector store)
data/
*.db
*.sqlite3
chroma/

# Virtual environment
env/

# Python cache
__pycache__/
*.pyc
*.pyo
.env

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Systemd user service (user-specific paths)
amnis-web.service

# Build artifacts
build/
dist/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Personal analysis scripts (not part of the app)
check_memories.py
check_sources.py
create_vault_memories.py
memory-gap-analysis.md
*.bak
